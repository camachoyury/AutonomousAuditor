# GitHub (opcional: solo para `python -m auditor.agent` y la API)
GITHUB_TOKEN=            # (solo integración con GitHub) token con acceso al repo de reportes (contents: read, issues: write)
GITHUB_REPO_OWNER=camachoyury
GITHUB_REPO_NAME=financial-reports
GITHUB_BRANCH=main

# Gemini (si falta, la auditoría corre solo con las reglas deterministas)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AUDITOR_USE_LLM=false   # desactiva Gemini aunque haya API key

# API (app.py)
GITHUB_WEBHOOK_SECRET=    # obligatorio para /webhook/github
AUDIT_API_KEY=            # obligatorio para POST /audit (cabecera X-API-Key)
